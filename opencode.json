{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".roo/rules/rules.md",
    ".roo/rules/project-context.md",
    ".roo/rules/architecture-layers.md",
    ".roo/rules/angular-signals.md",
    ".roo/rules/ui-standards.md",
    ".roo/rules/erp-core.md",
    ".roo/rules/plm-spec.md",
    ".opencode/agents/orchestrator.md",
    ".opencode/plans/00-plan-index.md"
  ],
  "agent": {
