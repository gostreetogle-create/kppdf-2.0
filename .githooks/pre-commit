#!/usr/bin/env bash
# KPPDF 2.0 — Pre-commit hook
# Установка: git config core.hooksPath .githooks
set -euo pipefail

echo "=== Pre-commit check ==="

# ESLint
echo "[1/3] Linting..."
npx ng lint 2>/dev/null || { echo "❌ ESLint failed"; exit 1; }

# TypeScript check
echo "[2/3] TypeScript check..."
npx tsc --noEmit --pretty 2>/dev/null || { echo "❌ TypeScript check failed"; exit 1; }

# Prettier check
echo "[3/3] Code formatting..."
npx prettier --check "src/**/*.ts" --check "src/**/*.html" --check "src/**/*.scss" 2>/dev/null || {
    echo "⚠️  Prettier check failed. Run: npx prettier --write ."
    exit 1
}

echo "=== ✅ All checks passed ==="
