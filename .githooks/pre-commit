#!/bin/sh
# Pre-commit hook for KPPDF 2.0
# Runs linting and type checks before every commit.

echo "🔍 Running pre-commit checks..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|html|scss)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No staged files to check."
  exit 0
fi

# Run lint on staged TS/HTML files
echo "  → Linting..."
npx ng lint --force 2>/dev/null
LINT_EXIT=$?

if [ $LINT_EXIT -ne 0 ]; then
  echo "❌ Lint failed. Fix errors before committing."
  echo "   Run: npx ng lint"
  exit 1
fi

# Run type check
echo "  → Type checking..."
npx tsc --noEmit --project tsconfig.app.json 2>/dev/null
TSC_EXIT=$?

if [ $TSC_EXIT -ne 0 ]; then
  echo "❌ TypeScript errors found. Fix them before committing."
  echo "   Run: npx tsc --noEmit"
  exit 1
fi

echo "✅ Pre-commit checks passed!"
