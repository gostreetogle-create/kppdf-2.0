# Сервер
PORT=3000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kppdf

# JWT — СМЕНИТЬ НА СВОЙ СЛУЧАЙНЫЙ КЛЮЧ!
JWT_SECRET=change-me-to-random-64-chars-minimum-for-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=https://kppdf.local

# DaData (опционально, для подсказок адресов)
DADATA_TOKEN=
